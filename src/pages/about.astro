---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import site from '../data/site.json';

const years = new Date().getFullYear() - site.licensedSince;
const phoneTel = `+1${site.phone.replace(/\D/g, '')}`;
---

<Layout
  title="About"
  description={`About Laura D. Farley, MBA — Listing Agent & Broker Associate with eXp Realty. Licensed REALTOR® since ${site.licensedSince}. Temecula homes & estates. DRE# ${site.dre}.`}
>
  <Navbar />
  <main class="bg-[var(--linen)]">
    <div class="max-w-5xl mx-auto px-5 sm:px-6 py-14">
      <div class="grid lg:grid-cols-5 gap-12 items-start">
        <div class="lg:col-span-2">
          <div class="rounded-3xl overflow-hidden border border-[var(--taupe)] shadow-lg bg-[var(--alabaster)]">
            <img
              src={site.headshot}
              alt={site.nameWithCredentials}
              class="w-full h-auto object-cover object-top"
              width="1280"
              height="853"
            />
          </div>
          <div class="mt-5 text-sm text-stone-600 space-y-1">
            <div class="font-semibold text-[var(--sage-ink)] text-lg">{site.nameWithCredentials}</div>
            <div>Listing Agent · {site.title}</div>
            <div>{site.brokerage}</div>
            <div>DRE# {site.dre}</div>
            <a class="block text-[var(--sage-ink)] font-medium hover:underline pt-2" href={`tel:${phoneTel}`}>{site.phone}</a>
            <a class="block text-[var(--sage-ink)] font-medium hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>

        <div class="lg:col-span-3">
          <h1 class="font-serif text-4xl sm:text-5xl text-[var(--sage-ink)] mb-2">About Laura</h1>
          <p class="text-[var(--sage-deep)] text-lg mb-6">{site.nameWithCredentials}</p>

          <blockquote class="pull-quote mb-8">
            Listing-first. You work with me directly — not a revolving handoff.
          </blockquote>

          <div class="space-y-5 text-lg text-stone-700 leading-relaxed">
            <p>
              I’m <strong>{site.nameWithCredentials}</strong>, a Listing Agent and {site.title} with {site.brokerage}, based in <strong>Temecula</strong>.
              I’ve held my California real estate license since
              <strong> {site.licensedSince}</strong> — {years}+ years as a licensed Realtor helping sellers bring homes and estates to market with focused, modern guidance.
            </p>
            <p>
              My primary focus is <strong>listings</strong>: pricing strategy, preparation, presentation, and negotiation designed to protect your equity. I also represent buyers when the fit is right — same direct access, same clear communication.
            </p>
            <p>
              Whether you are preparing to list in wine country, relocating into Temecula, or expanding a search toward Orange County, I will help you build a strategy that fits your timeline and goals.
            </p>
            <p>
              From 2008 through recovery into 2012 I negotiated short sales when many homeowners had little or no equity.
              I have represented VA and FHA buyers, and I have handled 1031 exchanges, including multi-state exchanges,
              alongside the client’s tax and legal advisors. Read
              <a class="underline text-[var(--sage-deep)]" href="/1031-exchange">1031 exchanges, including multi-state</a>.
            </p>
          </div>

          <div class="mt-10 grid sm:grid-cols-2 gap-4">
            <div class="listing-card p-5">
              <div class="text-sm text-stone-500">License</div>
              <div class="font-semibold text-[var(--sage-ink)] mt-1">CA DRE# {site.dre}</div>
            </div>
            <div class="listing-card p-5">
              <div class="text-sm text-stone-500">Brokerage</div>
              <div class="font-semibold text-[var(--sage-ink)] mt-1">{site.brokerage}</div>
            </div>
            <div class="listing-card p-5">
              <div class="text-sm text-stone-500">Primary market</div>
              <div class="font-semibold text-[var(--sage-ink)] mt-1">Temecula</div>
            </div>
            <div class="listing-card p-5">
              <div class="text-sm text-stone-500">Licensed since</div>
              <div class="font-semibold text-[var(--sage-ink)] mt-1">{site.licensedSince}</div>
            </div>
          </div>

          <div class="mt-10 flex flex-wrap gap-3">
            <a href="/sell#valuation" class="btn-primary">Free home value</a>
            <a href="/contact" class="btn-outline">Contact Laura</a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
