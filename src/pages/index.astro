---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import LeadForm from '../components/LeadForm.astro';
import site from '../data/site.json';
import areas from '../data/areas.json';

const years = new Date().getFullYear() - site.licensedSince;
const phoneTel = `+1${site.phone.replace(/\D/g, '')}`;

// Homepage area cards: Temecula focus + OC + Hacienda Heights
const homeAreas = ['temecula', 'orange-county', 'hacienda-heights']
  .map((slug) => areas.find((a) => a.slug === slug))
  .filter(Boolean) as typeof areas;

const areaLabel: Record<string, string> = {
  temecula: 'Temecula Valley',
  'orange-county': 'Orange County',
  'hacienda-heights': 'Hacienda Heights',
};

const whyLaura = [
  {
    title: 'You work with me directly',
    body: 'From first call to closing, you get clear communication from your agent and a steady point of contact through every step.',
  },
  {
    title: 'Residential listing & selling',
    body: 'My work centers on listing and selling residential real estate — helping homeowners sell with a clear plan and helping buyers purchase with the same careful guidance.',
  },
  {
    title: 'Business-minded strategy',
    body: 'With an MBA background, I bring a practical, numbers-aware approach to pricing, marketing decisions, and offer analysis.',
  },
  {
    title: 'Cross-Marketing Strategy',
    body: 'With offices in Temecula, Orange County, and Hacienda Heights, I am equipped to work across a large geographic area and complete multiple-property transactions when a move connects those markets.',
  },
  {
    title: 'Honest, steady guidance',
    body: 'You’ll get a clear recommendation on timing, preparation, and price so you can move forward with confidence.',
  },
  {
    title: 'Marketing done with care',
    body: 'Professional presentation, strategic online exposure, and a clear plan for showings and feedback so your home reaches serious buyers.',
  },
];

const processSteps = [
  {
    n: '01',
    title: 'Home consultation',
    body: 'We walk through your goals, timeline, property condition, and what success looks like for your next chapter.',
  },
  {
    n: '02',
    title: 'Pricing strategy',
    body: 'Comparable sales, active competition, and buyer demand shape a pricing plan designed to attract serious interest while protecting value.',
  },
  {
    n: '03',
    title: 'Prepare & present',
    body: 'Practical prep priorities, professional photography direction, and listing presentation aligned with how today’s buyers shop.',
  },
  {
    n: '04',
    title: 'Market with intention',
    body: 'Targeted online exposure and a showing plan that helps the right buyers discover your home.',
  },
  {
    n: '05',
    title: 'Negotiate with care',
    body: 'Offers, terms, repairs, and contingencies reviewed in plain language so you can decide with confidence.',
  },
  {
    n: '06',
    title: 'Close with clarity',
    body: 'From accepted offer through escrow, you stay informed on next steps, dates, and what needs your attention.',
  },
];

const faqs = [
  {
    q: 'How much is my Temecula home worth?',
    a: 'A useful answer starts with recent comparable sales, current competition, condition, and location nuances. I provide a complimentary market valuation and walk you through the reasoning behind the number.',
  },
  {
    q: 'Is now a good time to sell?',
    a: 'It depends on your equity position, timeline, local inventory, and what you need next. Sometimes waiting or prepping first is the smarter path. I’ll give you a direct read for your situation.',
  },
  {
    q: 'Do I need to make repairs before listing?',
    a: 'Not always. We’ll separate high-ROI fixes from nice-to-haves so you invest where it counts. Presentation and pricing often matter more than a full remodel.',
  },
  {
    q: 'Can I buy before I sell?',
    a: 'Often yes, with the right structure: contingencies, bridge options, or sequenced timing. We’ll map the path that fits your risk tolerance and financing.',
  },
  {
    q: 'Do you work with buyers as well as sellers?',
    a: 'Yes. I list and sell residential real estate — representing sellers bringing a home to market and buyers searching for their next home. You’ll work directly with your agent either way.',
  },
  {
    q: 'What makes you different from other Realtors?',
    a: 'You work directly with your agent, a clear focus on residential listing and selling, 21+ years as a licensed REALTOR®, and an MBA-informed approach to pricing and negotiation built around strategy and communication.',
  },
  {
    q: 'Do you help with estates or more complex sales?',
    a: 'Yes. Sensitive timelines, multiple decision-makers, and “what do we do first?” situations are welcome. We’ll start with a calm plan and next steps.',
  },
];
---

<Layout
  title="Temecula Listing Agent · Homes for Sellers & Buyers"
  description={`Laura D. Farley, MBA — Temecula Listing Agent & Broker Associate with ${site.brokerage}. ${years}+ years licensed REALTOR® helping sellers and buyers across Temecula Valley, Orange County, and Hacienda Heights. Free home valuation. DRE# ${site.dre}.`}
>
  <Navbar />

  <!-- ========== HERO ========== -->
  <header class="relative overflow-hidden min-h-[88vh] flex flex-col justify-center">
    <div class="absolute inset-0">
      <img
        src="/images/hero-sanctuary.jpg"
        alt="Bright living room — Temecula home inspiration"
        class="w-full h-full object-cover object-center"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[rgba(246,247,242,0.92)] via-[rgba(246,247,242,0.62)] to-[rgba(246,247,242,0.14)]"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[rgba(246,247,242,0.62)] via-transparent to-[rgba(246,247,242,0.22)]"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-5 sm:px-6 py-16 sm:py-24 w-full">
      <div class="max-w-2xl">
        <p class="text-[var(--sage)] text-[11px] sm:text-xs font-medium tracking-[0.28em] uppercase mb-5">
          Temecula Listing Agent · Residential Real Estate · {site.brokerage}
        </p>
        <h1 class="font-serif text-[var(--sage-ink)] text-4xl sm:text-5xl lg:text-6xl leading-[1.05] tracking-[0.01em]">
          Sell with strategy.<br class="hidden sm:block" /> Buy with confidence.
        </h1>
        <p class="mt-6 text-base sm:text-lg max-w-xl leading-relaxed text-[var(--sage-deep)] font-light">
          Informed choices. Confident moves. A strategic approach to residential real estate throughout Southern California.
        </p>
        <p class="mt-4 text-sm sm:text-base max-w-xl leading-relaxed text-[var(--muted)]">
          I focus on listing and selling residential real estate, helping sellers bring homes to market and assisting
          buyers with finding the right home. Your property is one of your largest financial assets, and you deserve an
          agent who protects your equity, negotiates carefully, and keeps you informed every step of the way.
        </p>
        <p class="mt-3 text-xs sm:text-sm tracking-wide text-[var(--muted)]">
          Temecula Valley · Orange County · Hacienda Heights
          <span class="mx-1.5 opacity-40">·</span>
          DRE# {site.dre}
        </p>
      </div>

      <div class="mt-10 max-w-3xl rounded-full border border-white/70 bg-white/55 backdrop-blur-md shadow-[0_18px_50px_rgba(79,92,76,0.12)] p-2 sm:p-2.5">
        <div class="flex flex-col sm:flex-row gap-2 sm:items-center">
          <a href="#valuation" class="btn-primary flex-1 text-center !py-3">What is my home worth?</a>
          <a href="/sell" class="btn-sage-soft flex-1 text-center">I want to sell</a>
          <a href="/buy" class="btn-sage-soft flex-1 text-center">I want to buy</a>
          <a href="#consult" class="btn-sage-soft flex-1 text-center">Free consultation</a>
        </div>
      </div>

      <dl class="mt-10 grid grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl">
        <div>
          <dt class="font-serif text-3xl sm:text-4xl text-[var(--sage-ink)]">{years}+</dt>
          <dd class="text-[11px] tracking-[0.16em] uppercase text-[var(--sage)] mt-1">Years licensed</dd>
        </div>
        <div>
          <dt class="font-serif text-3xl sm:text-4xl text-[var(--sage-ink)]">Focus</dt>
          <dd class="text-[11px] tracking-[0.14em] uppercase text-[var(--sage)] mt-1 leading-snug">Listing &amp; selling residential real estate</dd>
        </div>
        <div>
          <dt class="font-serif text-3xl sm:text-4xl text-[var(--sage-ink)]">Direct</dt>
          <dd class="text-[11px] tracking-[0.12em] uppercase text-[var(--sage)] mt-1 leading-snug">Dedicated to working with you directly</dd>
        </div>
        <div>
          <dt class="font-serif text-3xl sm:text-4xl text-[var(--sage-ink)]">Versatility</dt>
          <dd class="text-[11px] tracking-[0.12em] uppercase text-[var(--sage)] mt-1 leading-snug">Cabins to Castles and everything in between</dd>
        </div>
      </dl>
    </div>
  </header>

  <!-- ========== TRUST BADGES ========== -->
  <section class="bg-white border-b border-[var(--line)]" aria-label="Credentials">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 py-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[11px] sm:text-xs tracking-[0.14em] uppercase text-[var(--muted)]">
      <span class="font-semibold text-[var(--sage-deep)]">REALTOR®</span>
      <span class="opacity-30">·</span>
      <span>Broker Associate</span>
      <span class="opacity-30">·</span>
      <span>MBA</span>
      <span class="opacity-30">·</span>
      <span>{site.brokerage}</span>
      <span class="opacity-30">·</span>
      <span>DRE# {site.dre}</span>
      <span class="opacity-30">·</span>
      <span>Equal Housing Opportunity</span>
    </div>
  </section>

  <!-- ========== HOMEOWNER / CLIENT FRAME ========== -->
  <section class="bg-[var(--ivory)] border-b border-[var(--line)]">
    <div class="max-w-3xl mx-auto px-5 sm:px-6 py-16 sm:py-20 text-center">
      <p class="text-[11px] tracking-[0.22em] uppercase text-[var(--sage)] font-medium mb-3">Sellers &amp; buyers</p>
      <h2 class="font-serif text-3xl sm:text-5xl text-[var(--sage-ink)] leading-tight">
        A clear plan for your next move
      </h2>
      <p class="mt-6 text-[var(--muted)] text-base sm:text-lg leading-relaxed">
        Pricing questions, preparation choices, showings, offers, and timing can feel like a lot at once.
        Whether you’re listing a home or searching for the next one — across town or farther — you deserve a
        Temecula REALTOR® who explains the market in plain language, protects your position, and stays reachable
        when decisions matter.
      </p>
      <p class="mt-5 text-[var(--sage-deep)] leading-relaxed font-medium">
        I focus on listing and selling residential real estate — with the same care whether you are selling, buying, or both.
      </p>
    </div>
  </section>

  <!-- ========== WHY LAURA ========== -->
  <section class="bg-white border-b border-[var(--line)]" id="why-laura">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 py-16 sm:py-20">
      <div class="max-w-2xl mb-12">
        <p class="text-[11px] tracking-[0.22em] uppercase text-[var(--sage)] font-medium mb-3">Why clients choose Laura</p>
        <h2 class="font-serif text-4xl sm:text-5xl text-[var(--sage-ink)] leading-tight">
          What working together looks like
        </h2>
        <p class="mt-4 text-[var(--muted)] leading-relaxed">
          Clear communication and a steady process for homeowners listing a property and for buyers ready to purchase.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {whyLaura.map((item) => (
          <div class="listing-card p-6">
            <div class="text-[var(--sage)] text-lg mb-2">✓</div>
            <h3 class="font-serif text-2xl text-[var(--sage-ink)] leading-snug">{item.title}</h3>
            <p class="text-sm text-[var(--muted)] mt-3 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== MEET LAURA ========== -->
  <section class="relative bg-[var(--ivory)] border-b border-[var(--line)] overflow-hidden">
    <div class="pointer-events-none absolute left-4 top-10 leaf-deco hidden md:block" aria-hidden="true">
      <svg width="72" height="120" viewBox="0 0 72 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M20 10c18 18 22 42 8 70-10 20-28 30-28 30s8-22 6-42C4 42 12 22 20 10z" stroke="currentColor" stroke-width="1.2"></path>
        <path d="M28 24c14 14 16 34 6 56" stroke="currentColor" stroke-width="1"></path>
        <path d="M40 8c16 20 18 46 4 74" stroke="currentColor" stroke-width="1"></path>
      </svg>
    </div>
    <div class="max-w-6xl mx-auto px-5 sm:px-6 py-16 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-[11px] tracking-[0.22em] uppercase text-[var(--sage)] font-medium mb-3">Meet your agent</p>
        <h2 class="font-serif text-4xl sm:text-5xl text-[var(--sage-ink)] leading-tight tracking-wide">
          {site.nameWithCredentials}
        </h2>
        <p class="mt-2 text-sm text-[var(--muted)] tracking-wide">
          Listing &amp; selling residential real estate · {site.title} · {site.brokerage}
        </p>
        <div class="mt-8 flex gap-5 items-start">
          <img
            src={site.headshot}
            alt={site.nameWithCredentials}
            class="w-24 h-24 rounded-full object-cover object-top border border-[var(--line)] shadow-sm shrink-0"
            width="192"
            height="192"
          />
          <div class="space-y-4 text-[var(--muted)] leading-relaxed">
            <p>
              Real estate is about helping people navigate one of life’s biggest financial decisions with a clear head
              and a solid plan.
            </p>
            <p>
              For more than two decades I’ve helped California homeowners sell with confidence through strategic
              pricing, strong negotiation, and honest communication. With an MBA background, I evaluate options carefully
              and keep recommendations practical and easy to act on.
            </p>
            <p>
              Today my focus is listing and selling residential real estate in Temecula, with service also available in
              Orange County and Hacienda Heights, whether you are bringing a home to market or searching for your next one.
            </p>
            <p>
              Since 2005 I have built a trusted network of agents I collaborate with across Southern California, so
              clients can buy and sell across markets with coordinated representation.
            </p>
            <p>
              As a California native, I know how communities across Southern California differ, from Temecula Valley to
              Orange County and Hacienda Heights, and I use that local fluency to help you choose well.
            </p>
          </div>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`tel:${phoneTel}`} class="btn-primary">Call or text {site.phone}</a>
          <a href="/about" class="btn-outline">More about Laura</a>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <a href="/sell#valuation" class="listing-card p-6 block group ring-1 ring-[var(--sage)]/25">
          <div class="text-[10px] tracking-[0.18em] uppercase text-[var(--sage)] font-semibold mb-2">Sellers</div>
          <h3 class="font-serif text-2xl text-[var(--sage-ink)] group-hover:text-[var(--sage-deep)] transition">
            List with a plan
          </h3>
          <p class="text-sm text-[var(--muted)] mt-3 leading-relaxed">
            Complimentary market valuation and a clear listing strategy for your Temecula home or estate.
          </p>
          <div class="mt-5 text-[var(--sage-deep)] text-xs font-semibold tracking-[0.14em] uppercase">
            Find out what your home is worth →
          </div>
        </a>
        <a href="/buy" class="listing-card p-6 block group">
          <div class="text-[10px] tracking-[0.18em] uppercase text-[var(--sage)] font-semibold mb-2">Buyers</div>
          <h3 class="font-serif text-2xl text-[var(--sage-ink)] group-hover:text-[var(--sage-deep)] transition">
            Buy with strategy
          </h3>
          <p class="text-sm text-[var(--muted)] mt-3 leading-relaxed">
            Neighborhood fit, pricing reality, and offer strategy — with direct guidance from your agent.
          </p>
          <div class="mt-5 text-[var(--sage-deep)] text-xs font-semibold tracking-[0.14em] uppercase">
            Schedule a buyer consult →
          </div>
        </a>
        <a href="/areas/temecula-communities" class="listing-card p-6 block group sm:col-span-2">
          <div class="text-[10px] tracking-[0.18em] uppercase text-[var(--sage)] font-semibold mb-2">Primary market</div>
          <h3 class="font-serif text-2xl text-[var(--sage-ink)] group-hover:text-[var(--sage-deep)] transition">
            Temecula Valley homes &amp; estates
          </h3>
          <p class="text-sm text-[var(--muted)] mt-3 leading-relaxed">
            Local guidance for sellers and buyers across Temecula — from established neighborhoods to lifestyle properties
            near Wine Country. Start with my notes on Chardonnay Hills, Crowne Hill, and eight other communities.
          </p>
          <p class="text-xs text-[var(--muted)] mt-3 tracking-wide">
            Also: Orange County · Hacienda Heights
          </p>
          <div class="mt-5 text-[var(--sage-deep)] text-xs font-semibold tracking-[0.14em] uppercase">
            Explore Temecula area guidance →
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ========== PROCESS ========== -->
  <section class="bg-white border-b border-[var(--line)]" id="process">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 py-16 sm:py-20">
      <div class="max-w-2xl mb-12">
        <p class="text-[11px] tracking-[0.22em] uppercase text-[var(--sage)] font-medium mb-3">Selling made simpler</p>
        <h2 class="font-serif text-4xl sm:text-5xl text-[var(--sage-ink)] leading-tight">
          A clear path from “thinking about it” to closed
        </h2>
        <p class="mt-4 text-[var(--muted)] leading-relaxed">
          Whether this is your first listing or it’s been years since your last move, here’s how we work together step by step.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {processSteps.map((step) => (
          <div class="listing-card p-6">
            <div class="font-serif text-3xl text-[var(--sage)] mb-2">{step.n}</div>
            <h3 class="font-serif text-2xl text-[var(--sage-ink)]">{step.title}</h3>
            <p class="text-sm text-[var(--muted)] mt-3 leading-relaxed">{step.body}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/sell" class="btn-primary">Seller services</a>
        <a href="/buy" class="btn-outline">Buyer services</a>
      </div>
    </div>
  </section>

  <!-- ========== MARKET EXPERTISE ========== -->
  <section class="bg-[var(--ivory)] border-b border-[var(--line)]">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 py-16 sm:py-20 grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <p class="text-[11px] tracking-[0.22em] uppercase text-[var(--sage)] font-medium mb-3">Local market expertise</p>
        <h2 class="font-serif text-4xl sm:text-5xl text-[var(--sage-ink)] leading-tight">
          Temecula Valley, neighborhood by neighborhood
        </h2>
        <p class="mt-5 text-[var(--muted)] leading-relaxed">
          Understanding neighborhood trends, buyer demand, pricing strategy, and seasonal patterns helps position your
          home to attract serious buyers — whether you’re in a master-planned community, near Wine Country amenities,
          or in an established neighborhood with its own comps and buyer profile.
        </p>
        <p class="mt-4 text-[var(--muted)] leading-relaxed">
          Temecula is the heart of my practice. I also support clients in Orange County and Hacienda Heights when your
          move connects those areas.
        </p>
        <p class="mt-4 text-sm text-[var(--muted)] tracking-wide">
          Temecula Valley · Orange County · Hacienda Heights
        </p>
        <a href="/areas" class="btn-outline mt-8">View areas served</a>
      </div>
      <div class="grid sm:grid-cols-1 gap-4">
        {homeAreas.map((a) => (
          <a href={`/areas/${a.slug}`} class="listing-card p-5 block">
            <div class="font-serif text-2xl text-[var(--sage-ink)]">{areaLabel[a.slug] || a.name}</div>
            <div class="text-[10px] tracking-[0.14em] uppercase text-[var(--sage)] mt-1">{a.region}</div>
            <p class="text-sm text-[var(--muted)] mt-3">{a.blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="bg-white border-b border-[var(--line)]" id="faq">
    <div class="max-w-3xl mx-auto px-5 sm:px-6 py-16 sm:py-20">
      <p class="text-[11px] tracking-[0.22em] uppercase text-[var(--sage)] font-medium mb-3">FAQ</p>
      <h2 class="font-serif text-4xl sm:text-5xl text-[var(--sage-ink)] leading-tight mb-10">
        Common questions
      </h2>
      <div class="space-y-4">
        {faqs.map((item) => (
          <details class="listing-card group p-5 sm:p-6">
            <summary class="font-serif text-xl sm:text-2xl text-[var(--sage-ink)] cursor-pointer list-none flex items-start justify-between gap-4">
              <span>{item.q}</span>
              <span class="text-[var(--sage)] text-lg shrink-0 group-open:rotate-45 transition">+</span>
            </summary>
            <p class="mt-4 text-[var(--muted)] leading-relaxed text-sm sm:text-base">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== CLOSING + FORM ========== -->
  <section class="max-w-6xl mx-auto px-5 sm:px-6 py-16 sm:py-20 grid lg:grid-cols-2 gap-12 items-start" id="consult">
    <div id="valuation">
      <p class="text-[11px] tracking-[0.22em] uppercase text-[var(--sage)] font-medium mb-3">Ready when you are</p>
      <h2 class="font-serif text-4xl sm:text-5xl text-[var(--sage-ink)] mb-6 leading-tight">
        Ready to make your next move?
      </h2>
      <p class="text-[var(--muted)] leading-relaxed mb-5">
        Whether you’re thinking about selling next month, exploring a purchase, or simply want to know what your home
        is worth, I’m happy to provide honest advice and a personalized strategy. There’s no pressure — just a
        conversation focused on your goals.
      </p>
      <ul class="space-y-3 text-[var(--muted)] mb-8">
        <li class="flex gap-2"><span class="text-[var(--sage)]">✓</span> {site.nameWithCredentials} · {site.title}</li>
        <li class="flex gap-2"><span class="text-[var(--sage)]">✓</span> Listing &amp; selling residential real estate · California REALTOR® (DRE# {site.dre})</li>
        <li class="flex gap-2"><span class="text-[var(--sage)]">✓</span> Temecula Valley · Orange County · Hacienda Heights</li>
        <li class="flex gap-2"><span class="text-[var(--sage)]">✓</span> Work directly with your agent — call or text <a class="underline text-[var(--sage-deep)]" href={`tel:${phoneTel}`}>{site.phone}</a></li>
        <li class="flex gap-2"><span class="text-[var(--sage)]">✓</span> <a class="underline text-[var(--sage-deep)]" href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
      <blockquote class="pull-quote">
        “Clear communication, honest pricing conversations, and negotiation that protects your interests.”
      </blockquote>
    </div>
    <LeadForm
      formName="home-lead"
      heading="Schedule your free consultation"
      subheading="Tell me about your home or move — selling, buying, or both. You’ll work directly with your agent. I typically respond within one business day."
      submitLabel="Let’s talk about your home"
      intentDefault="valuation"
      showPropertyFields={true}
    />
  </section>
</Layout>
