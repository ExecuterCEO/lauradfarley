---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import LeadForm from '../components/LeadForm.astro';
import site from '../data/site.json';
import areas from '../data/areas.json';

const years = new Date().getFullYear() - site.licensedSince;
const phoneTel = `+1${site.phone.replace(/\D/g, '')}`;
---

<Layout
  title="Temecula REALTOR®"
  description={`Laura D. Farley, Broker Associate with eXp Realty. ${years}+ years helping buyers and sellers in Temecula. Free home valuation. DRE# ${site.dre}.`}
>
  <Navbar />

  <!-- Hero: luxury interior background (user-provided sanctuary image) -->
  <header class="relative overflow-hidden min-h-[86vh] flex flex-col justify-center">
    <div class="absolute inset-0">
      <img
        src="/images/hero-sanctuary.jpg"
        alt="Bright luxury living room with crystal chandelier"
        class="w-full h-full object-cover object-center"
        width="1600"
        height="900"
      />
      <!-- Soft Chantilly Lace veil so sage/charcoal type stays readable -->
      <div class="absolute inset-0 bg-gradient-to-r from-[rgba(246,247,242,0.90)] via-[rgba(246,247,242,0.55)] to-[rgba(246,247,242,0.12)]"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[rgba(246,247,242,0.58)] via-transparent to-[rgba(246,247,242,0.22)]"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-5 sm:px-6 py-16 sm:py-24 w-full">
      <div class="max-w-2xl">
        <p class="text-[var(--sage)] text-[11px] sm:text-xs font-medium tracking-[0.28em] uppercase mb-5">
          Temecula · {site.brokerage}
        </p>
        <h1 class="font-serif text-[var(--sage-ink)] text-5xl sm:text-6xl lg:text-7xl leading-[0.98] tracking-[0.02em]">
          Discover your<br />sanctuary.
        </h1>
        <p class="mt-6 text-base sm:text-lg max-w-lg leading-relaxed text-[var(--sage-deep)] font-light">
          Temecula homes &amp; estates with calm, modern guidance — {years}+ years licensed, direct access to me.
        </p>
      </div>

      <!-- Frosted CTA bar (Élégance-style) -->
      <div class="mt-10 max-w-3xl rounded-full border border-white/70 bg-white/55 backdrop-blur-md shadow-[0_18px_50px_rgba(79,92,76,0.12)] p-2 sm:p-2.5">
        <div class="flex flex-col sm:flex-row gap-2 sm:items-center">
          <a href="/sell#valuation" class="btn-sage-soft flex-1 text-center">Home value</a>
          <a href="/buy" class="btn-sage-soft flex-1 text-center">I want to buy</a>
          <a href="/areas" class="btn-sage-soft flex-1 text-center">Areas</a>
          <a href="/contact" class="btn-primary flex-1 text-center !py-3">Connect</a>
        </div>
      </div>

      <dl class="mt-10 grid grid-cols-2 sm:grid-cols-3 gap-6 max-w-xl">
        <div>
          <dt class="font-serif text-3xl sm:text-4xl text-[var(--sage-ink)]">{years}+</dt>
          <dd class="text-[11px] tracking-[0.16em] uppercase text-[var(--sage)] mt-1">Years licensed</dd>
        </div>
        <div>
          <dt class="font-serif text-3xl sm:text-4xl text-[var(--sage-ink)]">1:1</dt>
          <dd class="text-[11px] tracking-[0.16em] uppercase text-[var(--sage)] mt-1">Direct contact</dd>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <dt class="font-serif text-3xl sm:text-4xl text-[var(--sage-ink)]">Temecula</dt>
          <dd class="text-[11px] tracking-[0.16em] uppercase text-[var(--sage)] mt-1">Primary market</dd>
        </div>
      </dl>
    </div>
  </header>

  <!-- Meet your agent -->
  <section class="relative bg-[var(--ivory)] border-b border-[var(--line)] overflow-hidden">
    <div class="pointer-events-none absolute left-4 top-10 leaf-deco hidden md:block" aria-hidden="true">
      <svg width="72" height="120" viewBox="0 0 72 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M20 10c18 18 22 42 8 70-10 20-28 30-28 30s8-22 6-42C4 42 12 22 20 10z" stroke="currentColor" stroke-width="1.2"/>
        <path d="M28 24c14 14 16 34 6 56" stroke="currentColor" stroke-width="1"/>
        <path d="M40 8c16 20 18 46 4 74" stroke="currentColor" stroke-width="1"/>
      </svg>
    </div>
    <div class="max-w-6xl mx-auto px-5 sm:px-6 py-16 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-[11px] tracking-[0.22em] uppercase text-[var(--sage)] font-medium mb-3">Curating spaces, creating homes</p>
        <h2 class="font-serif text-4xl sm:text-5xl text-[var(--sage-ink)] leading-tight tracking-wide">
          Meet your agent,<br />{site.name}
        </h2>
        <div class="mt-8 flex gap-5 items-start">
          <img
            src={site.headshot}
            alt={site.name}
            class="w-20 h-20 rounded-full object-cover object-top border border-[var(--line)] shadow-sm"
            width="160"
            height="160"
          />
          <div>
            <p class="text-[var(--muted)] leading-relaxed">
              Broker Associate with {site.brokerage}. {years}+ years guiding Temecula buyers and sellers with clear communication and careful negotiation — you work with me directly.
            </p>
            <a href={`tel:${phoneTel}`} class="inline-block mt-3 text-sm font-medium text-[var(--sage-deep)] hover:underline tracking-wide">
              {site.phone}
            </a>
          </div>
        </div>
        <a href="/about" class="btn-outline mt-8">More about Laura</a>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <a href="/sell" class="listing-card p-6 block group">
          <div class="text-[10px] tracking-[0.18em] uppercase text-[var(--sage)] font-semibold mb-2">Sellers</div>
          <h3 class="font-serif text-2xl text-[var(--sage-ink)] group-hover:text-[var(--sage-deep)] transition">What’s my home worth?</h3>
          <p class="text-sm text-[var(--muted)] mt-3 leading-relaxed">Complimentary market valuation and a clear plan to sell.</p>
          <div class="mt-5 text-[var(--sage-deep)] text-xs font-semibold tracking-[0.14em] uppercase">Get free valuation →</div>
        </a>
        <a href="/buy" class="listing-card p-6 block group">
          <div class="text-[10px] tracking-[0.18em] uppercase text-[var(--sage)] font-semibold mb-2">Buyers</div>
          <h3 class="font-serif text-2xl text-[var(--sage-ink)] group-hover:text-[var(--sage-deep)] transition">Find your next home</h3>
          <p class="text-sm text-[var(--muted)] mt-3 leading-relaxed">Strategy before you write the offer — neighborhoods, pricing, timing.</p>
          <div class="mt-5 text-[var(--sage-deep)] text-xs font-semibold tracking-[0.14em] uppercase">Start buyer consult →</div>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="bg-white border-b border-[var(--line)]">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 py-10 grid sm:grid-cols-3 gap-8 text-center sm:text-left">
      <div>
        <div class="font-serif text-2xl text-[var(--sage-ink)]">Seller strategy</div>
        <p class="text-sm text-[var(--muted)] mt-2">Pricing, prep, and negotiation designed to protect your equity.</p>
      </div>
      <div>
        <div class="font-serif text-2xl text-[var(--sage-ink)]">Buyer advocacy</div>
        <p class="text-sm text-[var(--muted)] mt-2">Local insight across Temecula wine country and nearby communities.</p>
      </div>
      <div>
        <div class="font-serif text-2xl text-[var(--sage-ink)]">Direct access</div>
        <p class="text-sm text-[var(--muted)] mt-2">Call/text {site.phone} · {site.email}</p>
      </div>
    </div>
  </section>

  <!-- Areas -->
  <section class="bg-[var(--ivory)]">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 py-16">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
        <div>
          <p class="text-[11px] tracking-[0.22em] uppercase text-[var(--sage)] font-medium mb-2">Where I work</p>
          <h2 class="font-serif text-4xl sm:text-5xl text-[var(--sage-ink)]">Areas served</h2>
          <p class="text-[var(--muted)] mt-3 max-w-xl">
            Local guidance across Temecula and nearby Southwest Riverside communities — Orange County when your search expands.
          </p>
        </div>
        <a href="/areas" class="text-[var(--sage-deep)] text-xs font-semibold tracking-[0.16em] uppercase hover:underline">View all areas →</a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {areas.map((a) => (
          <a href={`/areas/${a.slug}`} class="listing-card p-5 block">
            <div class="font-serif text-2xl text-[var(--sage-ink)]">{a.name}</div>
            <div class="text-[10px] tracking-[0.14em] uppercase text-[var(--sage)] mt-1">{a.region}</div>
            <p class="text-sm text-[var(--muted)] mt-3 line-clamp-3">{a.blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Form -->
  <section class="max-w-6xl mx-auto px-5 sm:px-6 py-16 grid lg:grid-cols-2 gap-12 items-start">
    <div>
      <p class="text-[11px] tracking-[0.22em] uppercase text-[var(--sage)] font-medium mb-3">Let’s talk</p>
      <h2 class="font-serif text-4xl sm:text-5xl text-[var(--sage-ink)] mb-6">Request a callback</h2>
      <blockquote class="pull-quote mb-8">
        “Clear communication, honest pricing conversations, and negotiation that protects your interests.”
      </blockquote>
      <ul class="space-y-3 text-[var(--muted)]">
        <li class="flex gap-2"><span class="text-[var(--sage)]">✓</span> Licensed California REALTOR® (DRE# {site.dre})</li>
        <li class="flex gap-2"><span class="text-[var(--sage)]">✓</span> Primary focus: Temecula wine country</li>
        <li class="flex gap-2"><span class="text-[var(--sage)]">✓</span> Direct line — not a call-center handoff</li>
      </ul>
    </div>
    <LeadForm
      formName="home-lead"
      heading=""
      subheading="Share your goals — buying, selling, or both. I typically respond within one business day."
      submitLabel="Request callback"
      intentDefault="general"
    />
  </section>
</Layout>
