---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import LeadForm from '../components/LeadForm.astro';
import site from '../data/site.json';

const phoneTel = `+1${site.phone.replace(/\\D/g, '')}`;
---

<Layout
  title="Temecula Halloween, Thanksgiving, and Holiday Events"
  description={`Halloween carnival, Thanksgiving weekend, Temecula Chilled, and Christmas parade dates for Temecula residents and buyers. Laura D. Farley, MBA, ${site.brokerage}. DRE# ${site.dre}.`}
>
  <Navbar />
  <main>
    <section class="bg-[var(--sage-deep)] text-white">
      <div class="max-w-3xl mx-auto px-5 sm:px-6 py-14">
        <a href="/areas/temecula-communities" class="text-white/70 text-sm hover:text-white">← Temecula communities</a>
        <p class="text-[11px] tracking-[0.22em] uppercase text-white/70 font-medium mt-4">Local calendar</p>
        <h1 class="font-serif text-4xl sm:text-5xl mt-3 leading-tight">Halloween, Thanksgiving, and the holidays in Temecula</h1>
        <p class="mt-5 text-lg text-white/85 leading-relaxed">
          Neighborhood choice is daily life. So is the civic calendar: pumpkin farms, one Halloween night downtown,
          a quiet Thanksgiving table, then a month of lights. Dates below are from organizer pages as of late September 2026.
          Confirm before you block a showing or a family visit.
        </p>
      </div>
    </section>

    <article class="max-w-3xl mx-auto px-5 sm:px-6 py-14 space-y-6 text-[var(--muted)] text-lg leading-relaxed">
      <h2 class="font-serif text-3xl text-[var(--sage-ink)]">Halloween</h2>
      <p>
        <strong>Friday, October 30, 2026, 5:30–8:30 p.m.</strong> — City Halloween Carnival at the Civic Center plus
        trick-or-treating at participating Old Town businesses. Listing:
        <a class="underline text-[var(--sage-deep)]" href="https://oldtowntemecula.org/events-tickets/" target="_blank" rel="noopener noreferrer">Old Town Temecula events</a>.
        If you live in Paloma Del Sol, Crowne Hill, or Redhawk, this is a drive into town, not a walk. Budget parking.
      </p>
      <p>
        Pumpkin season runs through October 31 at
        <a class="underline text-[var(--sage-deep)]" href="https://www.peltzerfarms.com/" target="_blank" rel="noopener noreferrer">Peltzer Pumpkin Farm</a>
        (no dogs). Visit Temecula Valley also lists a corn maze through month-end on its
        <a class="underline text-[var(--sage-deep)]" href="https://www.visittemeculavalley.com/events/" target="_blank" rel="noopener noreferrer">events calendar</a>.
      </p>

      <h2 class="font-serif text-3xl text-[var(--sage-ink)]">Thanksgiving</h2>
      <p>
        Thanksgiving 2026 is Thursday, November 26. There is not a city-wide turkey parade that replaces a family meal.
        What follows immediately is more useful for residents:
      </p>
      <ul class="list-disc pl-6 space-y-2">
        <li><strong>Nov 27</strong> — Santa’s Arrival at Pennypickle’s Workshop (evening), then weekend Santa hours.</li>
        <li><strong>Nov 27–28</strong> — Shop Small Weekend in Old Town (Black Friday and Small Business Saturday).</li>
      </ul>
      <p>
        Both are on the
        <a class="underline text-[var(--sage-deep)]" href="https://oldtowntemecula.org/events-tickets/" target="_blank" rel="noopener noreferrer">Old Town calendar</a>.
        <a class="underline text-[var(--sage-deep)]" href="https://www.visittemeculavalley.com/temecula-chilled/" target="_blank" rel="noopener noreferrer">Temecula Chilled</a>
        (lights, ice, holiday dining) is framed as the day after Thanksgiving through December 31.
      </p>

      <h2 class="font-serif text-3xl text-[var(--sage-ink)]">Christmas and holiday lights</h2>
      <ul class="list-disc pl-6 space-y-2">
        <li><strong>Nov 19, 2026 – mid-January 2027</strong> — <a class="underline text-[var(--sage-deep)]" href="https://www.peltzerfarms.com/peltzer-ice-rink" target="_blank" rel="noopener noreferrer">Peltzer Ice Rink</a> (reserve sessions; rink site says closed until November 2026).</li>
        <li><strong>Dec 1–26</strong> — Window walk, Old Town storefronts.</li>
        <li><strong>Dec 3, 5:00–8:30 p.m.</strong> — Holiday Taste of Old Town (ticketed).</li>
        <li><strong>Dec 4, 7:00 p.m.</strong> — Santa’s Electric Light Parade (Old Town listing; some city pages still say Dec 5 — confirm that week).</li>
        <li><strong>Dec 10–12</strong> — A Very Temecula Christmas weekend, holiday boutique crawl, Cars/Cocoa/Carolers.</li>
        <li><strong>Dec 31</strong> — New Year’s Eve Grape Drop, Civic Center Quad.</li>
      </ul>
      <p>
        Parade night clogs Front Street. If you are showing or previewing a home in Meadowview or Harveston that evening,
        build extra drive time, or schedule the next morning.
      </p>
      <p>
        Wine-country pacing for the same season (tastings vs lights) is written up on Bellie Acres Wine:
        <a class="underline text-[var(--sage-deep)]" href="https://bellieacreswine.com/guides/temecula-holiday-wine-country/">Thanksgiving through New Year</a>
        and
        <a class="underline text-[var(--sage-deep)]" href="https://bellieacreswine.com/guides/temecula-halloween-fall-family/">Halloween and fall family days</a>.
        Neighborhood map:
        <a class="underline text-[var(--sage-deep)]" href="/areas/temecula-communities">Top Temecula communities</a>.
      </p>
      <p class="text-sm">
        {site.nameWithCredentials}, {site.title}, {site.brokerage}, DRE# {site.dre}.
        Call or text <a class="underline" href={`tel:${phoneTel}`}>{site.phone}</a>.
      </p>
    </article>

    <section class="bg-[var(--ivory)] border-t border-[var(--line)]">
      <div class="max-w-3xl mx-auto px-5 sm:px-6 py-16">
        <LeadForm
          formName="seasonal-events"
          heading="Buying or selling around the holidays?"
          subheading="Showings and listings still move in November and December. Tell me your timeline."
          submitLabel="Send message"
          intentDefault="general"
          showPropertyFields={true}
        />
      </div>
    </section>
  </main>
</Layout>
