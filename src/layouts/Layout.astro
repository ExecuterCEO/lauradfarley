---
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `${site.name} — ${site.title} with ${site.brokerage}. Helping buyers and sellers from Temecula to Orange County since ${site.licensedSince}. DRE# ${site.dre}.`,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.siteUrl).toString();
const years = new Date().getFullYear() - site.licensedSince;
const phoneTel = `+1${site.phone.replace(/\D/g, '')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${title} | ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(site.headshot, site.siteUrl).toString()} />
    <meta name="theme-color" content="#0F2C4C" />
    <title>{title} | {site.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-stone-50 text-stone-900 antialiased">
    <div class="bg-[var(--navy)] text-white/90 text-xs sm:text-sm text-center px-4 py-2">
      Call or text <a class="underline font-medium hover:text-white" href={`tel:${phoneTel}`}>{site.phone}</a>
      <span class="mx-1.5 opacity-50">·</span>
      <span>{site.brokerage}</span>
      <span class="mx-1.5 opacity-50">·</span>
      <span>DRE# {site.dre}</span>
    </div>
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  :root {
    --navy: #0f2c4c;
    --navy-deep: #0a1f36;
    /* Metallic platinum system (cool silver, not gold) */
    --platinum: #c5ccd4;
    --platinum-soft: #e8ecf0;
    --platinum-bright: #f3f5f7;
    --platinum-deep: #8b949e;
    --platinum-metal: linear-gradient(145deg, #f7f8fa 0%, #c5ccd4 42%, #9aa3ad 78%, #dfe3e8 100%);
    --ink: #1c1917;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: "DM Sans", system-ui, sans-serif;
  }

  .font-serif {
    font-family: "Libre Baskerville", Georgia, serif;
  }

  .btn-primary {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    @apply inline-flex items-center justify-center px-6 py-3.5 rounded-full font-semibold transition;
    color: var(--navy-deep);
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.7);
    /* Faceted diamond / gem body */
    background:
      linear-gradient(115deg, transparent 0%, transparent 42%, rgba(255, 255, 255, 0.9) 49.5%, transparent 57%, transparent 100%),
      linear-gradient(155deg, transparent 0%, transparent 35%, rgba(255, 255, 255, 0.45) 48%, transparent 62%),
      linear-gradient(35deg, #7a8490 0%, #aeb6c0 18%, #f7f9fb 36%, #d5dbe3 52%, #8e97a2 72%, #cfd5dd 88%, #f3f5f8 100%),
      linear-gradient(180deg, #eef2f6 0%, #b4bcc6 55%, #8b949e 100%);
    background-size: 220% 220%, 180% 180%, 100% 100%, 100% 100%;
    background-position: 30% 40%, 60% 30%, center, center;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.95) inset,
      0 -1px 0 rgba(90, 100, 112, 0.35) inset,
      0 0 0 1px rgba(155, 165, 176, 0.45) inset,
      0 10px 28px rgba(15, 44, 76, 0.28),
      0 2px 0 rgba(255, 255, 255, 0.25);
  }

  /* Crystal edge gleam */
  .btn-primary::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background:
      linear-gradient(105deg, transparent 0%, transparent 38%, rgba(255, 255, 255, 0.95) 50%, transparent 62%, transparent 100%);
    background-size: 220% 100%;
    background-position: 120% 0;
    animation: gem-shine 3.8s ease-in-out infinite;
    pointer-events: none;
  }

  /* Sparkle flecks */
  .btn-primary::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0.9;
    background:
      radial-gradient(circle at 18% 32%, rgba(255, 255, 255, 1) 0 1.1px, transparent 1.8px),
      radial-gradient(circle at 72% 28%, rgba(255, 255, 255, 0.95) 0 1px, transparent 1.7px),
      radial-gradient(circle at 58% 68%, rgba(255, 255, 255, 0.9) 0 1.2px, transparent 2px),
      radial-gradient(circle at 34% 74%, rgba(230, 240, 255, 0.95) 0 0.9px, transparent 1.6px),
      radial-gradient(circle at 84% 58%, rgba(255, 255, 255, 1) 0 1px, transparent 1.8px),
      radial-gradient(circle at 46% 22%, rgba(200, 220, 255, 0.9) 0 0.8px, transparent 1.5px);
    animation: gem-sparkle 2.4s ease-in-out infinite;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    filter: saturate(1.05) brightness(1.04);
    background-position: 55% 45%, 40% 50%, center, center;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 1) inset,
      0 -1px 0 rgba(90, 100, 112, 0.3) inset,
      0 0 0 1px rgba(180, 190, 205, 0.55) inset,
      0 14px 34px rgba(15, 44, 76, 0.34),
      0 0 18px rgba(200, 220, 255, 0.35);
  }

  .btn-primary:active {
    transform: translateY(0);
    filter: brightness(0.98);
  }

  @keyframes gem-shine {
    0%,
    55% {
      background-position: 130% 0;
      opacity: 0;
    }
    60% {
      opacity: 1;
    }
    78% {
      background-position: -30% 0;
      opacity: 0.85;
    }
    100% {
      background-position: -30% 0;
      opacity: 0;
    }
  }

  @keyframes gem-sparkle {
    0%,
    100% {
      opacity: 0.55;
      filter: brightness(1);
    }
    40% {
      opacity: 1;
      filter: brightness(1.25);
    }
    70% {
      opacity: 0.7;
      filter: brightness(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-primary::before,
    .btn-primary::after {
      animation: none;
    }
    .btn-primary:hover {
      transform: none;
    }
  }

  .btn-secondary {
    @apply inline-flex items-center justify-center px-6 py-3.5 rounded-full font-semibold transition;
    border: 1px solid rgba(220, 228, 238, 0.65);
    color: #f3f5f7;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.14) 0%, rgba(197, 204, 212, 0.08) 45%, rgba(255, 255, 255, 0.05) 100%);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.2) inset;
  }

  .btn-secondary:hover {
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.22) 0%, rgba(197, 204, 212, 0.14) 50%, rgba(255, 255, 255, 0.08) 100%);
    border-color: rgba(232, 236, 240, 0.85);
  }

  .btn-outline {
    @apply inline-flex items-center justify-center px-6 py-3.5 rounded-full border font-semibold transition bg-white;
    border-color: #c5ccd4;
    color: var(--navy);
  }

  .btn-outline:hover {
    border-color: var(--navy);
    background: var(--platinum-bright);
  }

  .input {
    @apply w-full px-4 py-3 rounded-xl border border-stone-300 bg-white focus:outline-none focus:ring-2 focus:border-[var(--platinum-deep)];
    focus-ring-color: transparent;
  }

  .input:focus {
    border-color: var(--platinum-deep);
    box-shadow: 0 0 0 3px rgba(197, 204, 212, 0.45);
  }

  .label {
    @apply block text-sm font-medium text-stone-700 mb-1.5;
  }
</style>
