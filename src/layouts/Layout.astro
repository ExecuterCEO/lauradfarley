---
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `${site.name} — ${site.title} with ${site.brokerage}. Helping buyers and sellers in Temecula and beyond since ${site.licensedSince}. DRE# ${site.dre}.`,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${title} | ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(site.headshot, site.siteUrl).toString()} />
    <meta name="theme-color" content="#4A5E4E" />
    <title>{title} | {site.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Google AdSense (Auto ads) — same publisher account as other Laura properties -->
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2494978762737398"
      crossorigin="anonymous"
    ></script>
  </head>
  <body class="antialiased">
    <div class="bg-[var(--sage-deep)] text-white text-center px-4 py-2.5">
      <div class="font-serif text-sm sm:text-base tracking-wide text-white">
        {site.nameWithCredentials}
      </div>
      <div class="mt-0.5 text-[10px] sm:text-[11px] text-white/90 tracking-[0.14em] uppercase">
        Listing Agent <span class="mx-1 opacity-60">•</span> Broker Associate <span class="mx-1 opacity-60">•</span> {site.brokerage}
      </div>
    </div>
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  :root {
    /* Exact mockup palette (Laura 2026-07-28) */
    --color-base-bg: #f6f7f2; /* Chantilly Lace */
    --color-primary-sage: #9aab97; /* Light Sage Accent */
    --color-dark-sage: #4a5e4e; /* Deep Sage / Buttons / Footer */
    --color-card-bg: #ffffff; /* Pure White */
    --color-text-main: #2b322c; /* Deep Charcoal */

    /* Semantic tokens mapped to exact palette */
    --ivory: var(--color-base-bg);
    --ivory-deep: #eef0e9;
    --cream: var(--color-base-bg);
    --cream-deep: #e8ebe3;
    --alabaster: var(--color-card-bg);
    --sage: var(--color-primary-sage);
    --sage-soft: #c5d1c2;
    --sage-mist: #dce4d9;
    --sage-mid: var(--color-primary-sage);
    --sage-deep: var(--color-dark-sage);
    --sage-ink: var(--color-dark-sage);
    --ink: var(--color-text-main);
    --muted: #5c665e;
    --line: #dfe4db;
    --taupe: #dfe4db;

    /* Legacy aliases used across pages */
    --linen: var(--color-base-bg);
    --espresso: var(--color-text-main);
    --espresso-soft: var(--color-dark-sage);
    --navy: var(--color-text-main);
    --navy-deep: var(--color-dark-sage);
    --platinum: var(--color-primary-sage);
    --platinum-soft: var(--sage-soft);
    --platinum-bright: var(--color-card-bg);
    --platinum-deep: var(--color-dark-sage);
    --amber: var(--color-dark-sage);
    --amber-deep: var(--color-dark-sage);
    --amber-soft: var(--sage-mist);
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: "Montserrat", system-ui, sans-serif;
    background: var(--ivory);
    color: var(--ink);
    font-weight: 400;
  }

  .font-serif {
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
  }

  .font-sans {
    font-family: "Montserrat", system-ui, sans-serif;
  }

  /* Deep Sage primary CTA (#4A5E4E) */
  .btn-primary {
    @apply inline-flex items-center justify-center px-7 py-3.5 font-medium transition tracking-[0.12em] uppercase text-xs sm:text-sm;
    color: #ffffff;
    border-radius: 999px;
    border: 1px solid var(--color-dark-sage);
    background: var(--color-dark-sage);
    box-shadow: 0 10px 24px rgba(74, 94, 78, 0.22);
  }

  .btn-primary:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
    box-shadow: 0 14px 28px rgba(74, 94, 78, 0.28);
  }

  .btn-primary:active {
    transform: translateY(0);
    filter: brightness(0.98);
  }

  .btn-secondary {
    @apply inline-flex items-center justify-center px-7 py-3.5 font-medium transition tracking-[0.12em] uppercase text-xs sm:text-sm;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.7);
    color: #ffffff;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(8px);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.24);
  }

  .btn-outline {
    @apply inline-flex items-center justify-center px-7 py-3.5 font-medium transition tracking-[0.12em] uppercase text-xs sm:text-sm;
    border-radius: 999px;
    border: 1px solid var(--color-primary-sage);
    color: var(--color-dark-sage);
    background: var(--color-card-bg);
  }

  .btn-outline:hover {
    border-color: var(--color-dark-sage);
    background: var(--color-base-bg);
  }

  /* Light sage accent pills (#9AAB97 family) */
  .btn-sage-soft {
    @apply inline-flex items-center justify-center px-5 py-3 font-medium transition tracking-[0.1em] uppercase text-[11px] sm:text-xs;
    border-radius: 999px;
    color: var(--color-dark-sage);
    background: color-mix(in srgb, var(--color-primary-sage) 28%, white);
    border: 1px solid color-mix(in srgb, var(--color-primary-sage) 45%, white);
  }

  .btn-sage-soft:hover {
    background: color-mix(in srgb, var(--color-primary-sage) 40%, white);
  }

  .input {
    @apply w-full px-4 py-3 rounded-full border bg-white focus:outline-none focus:ring-2;
    border-color: var(--line);
    background: var(--color-card-bg);
    color: var(--color-text-main);
    font-size: 0.95rem;
  }

  .input:focus {
    border-color: var(--color-primary-sage);
    box-shadow: 0 0 0 3px rgba(154, 171, 151, 0.28);
  }

  select.input {
    border-radius: 999px;
  }

  textarea.input {
    border-radius: 1.25rem;
  }

  .label {
    @apply block text-xs font-medium mb-1.5 tracking-[0.14em] uppercase;
    color: var(--muted);
  }

  .listing-card {
    background: var(--color-card-bg);
    border: 1px solid var(--line);
    border-radius: 1rem;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .listing-card:hover {
    border-color: var(--color-primary-sage);
    box-shadow: 0 14px 32px rgba(43, 50, 44, 0.08);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-dark-sage);
    background: color-mix(in srgb, var(--color-primary-sage) 22%, white);
  }

  .pull-quote {
    border-left: 3px solid var(--color-primary-sage);
    padding-left: 1.25rem;
    color: var(--color-text-main);
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1.4;
    font-style: italic;
  }

  /* Botanical leaf accents */
  .leaf-deco {
    color: var(--sage-soft);
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-primary:hover,
    .btn-secondary:hover {
      transform: none;
    }
  }
</style>
