---
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `${site.name} — ${site.title} with ${site.brokerage}. Helping buyers and sellers from Temecula to Orange County since ${site.licensedSince}. DRE# ${site.dre}.`,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.siteUrl).toString();
const years = new Date().getFullYear() - site.licensedSince;
const phoneTel = `+1${site.phone.replace(/\D/g, '')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${title} | ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(site.headshot, site.siteUrl).toString()} />
    <meta name="theme-color" content="#0F2C4C" />
    <title>{title} | {site.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-stone-50 text-stone-900 antialiased">
    <div class="bg-[var(--navy)] text-white/90 text-xs sm:text-sm text-center px-4 py-2">
      Call or text <a class="underline font-medium hover:text-white" href={`tel:${phoneTel}`}>{site.phone}</a>
      <span class="mx-1.5 opacity-50">·</span>
      <span>{site.brokerage}</span>
      <span class="mx-1.5 opacity-50">·</span>
      <span>DRE# {site.dre}</span>
    </div>
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  :root {
    /* Modern Botanical — silvery sage, dusty blush, cream */
    --cream: #f7f3ec;
    --cream-deep: #efe8dc;
    --sage: #8fa38a;
    --sage-soft: #c5d0c0;
    --sage-deep: #4a5c47;
    --sage-ink: #3a4838;
    --blush: #d4a8a4;
    --blush-soft: #e8cfcb;
    --blush-deep: #b88480;
    --ink: #2f332e;

    /* Aliases used across pages (legacy names → botanical) */
    --navy: var(--sage-ink);
    --navy-deep: #2f3b2e;
    --platinum: var(--blush);
    --platinum-soft: var(--blush-soft);
    --platinum-bright: var(--cream);
    --platinum-deep: var(--blush-deep);
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: "DM Sans", system-ui, sans-serif;
    background: var(--cream);
    color: var(--ink);
  }

  .font-serif {
    font-family: "Libre Baskerville", Georgia, serif;
  }

  .btn-primary {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    @apply inline-flex items-center justify-center px-6 py-3.5 rounded-full font-semibold transition;
    color: var(--sage-ink);
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.45);
    border: 1px solid rgba(255, 245, 240, 0.85);
    /* Soft botanical “petal” depth — sage + blush + cream */
    background:
      linear-gradient(115deg, transparent 0%, transparent 42%, rgba(255, 255, 255, 0.75) 49.5%, transparent 57%, transparent 100%),
      linear-gradient(155deg, #f7f3ec 0%, #e8cfcb 28%, #d4a8a4 52%, #c5d0c0 78%, #8fa38a 100%);
    background-size: 220% 220%, 100% 100%;
    background-position: 30% 40%, center;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.9) inset,
      0 -1px 0 rgba(74, 92, 71, 0.18) inset,
      0 10px 28px rgba(58, 72, 56, 0.18),
      0 2px 0 rgba(255, 255, 255, 0.2);
  }

  .btn-primary::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: linear-gradient(
      105deg,
      transparent 0%,
      transparent 38%,
      rgba(255, 255, 255, 0.85) 50%,
      transparent 62%,
      transparent 100%
    );
    background-size: 220% 100%;
    background-position: 120% 0;
    animation: gem-shine 4.2s ease-in-out infinite;
    pointer-events: none;
  }

  .btn-primary::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0.75;
    background:
      radial-gradient(circle at 18% 32%, rgba(255, 255, 255, 0.95) 0 1.1px, transparent 1.8px),
      radial-gradient(circle at 72% 28%, rgba(255, 250, 245, 0.9) 0 1px, transparent 1.7px),
      radial-gradient(circle at 58% 68%, rgba(232, 207, 203, 0.95) 0 1.2px, transparent 2px),
      radial-gradient(circle at 34% 74%, rgba(197, 208, 192, 0.9) 0 0.9px, transparent 1.6px);
    animation: gem-sparkle 2.8s ease-in-out infinite;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    filter: saturate(1.06) brightness(1.03);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 1) inset,
      0 14px 32px rgba(58, 72, 56, 0.22),
      0 0 16px rgba(212, 168, 164, 0.35);
  }

  .btn-primary:active {
    transform: translateY(0);
    filter: brightness(0.98);
  }

  @keyframes gem-shine {
    0%,
    55% {
      background-position: 130% 0;
      opacity: 0;
    }
    60% {
      opacity: 1;
    }
    78% {
      background-position: -30% 0;
      opacity: 0.85;
    }
    100% {
      background-position: -30% 0;
      opacity: 0;
    }
  }

  @keyframes gem-sparkle {
    0%,
    100% {
      opacity: 0.45;
      filter: brightness(1);
    }
    40% {
      opacity: 0.95;
      filter: brightness(1.15);
    }
    70% {
      opacity: 0.6;
      filter: brightness(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-primary::before,
    .btn-primary::after {
      animation: none;
    }
    .btn-primary:hover {
      transform: none;
    }
  }

  .btn-secondary {
    @apply inline-flex items-center justify-center px-6 py-3.5 rounded-full font-semibold transition;
    border: 1px solid rgba(232, 207, 203, 0.55);
    color: #f7f3ec;
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.16) 0%,
      rgba(212, 168, 164, 0.12) 45%,
      rgba(143, 163, 138, 0.1) 100%
    );
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.18) inset;
  }

  .btn-secondary:hover {
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.24) 0%,
      rgba(232, 207, 203, 0.18) 50%,
      rgba(197, 208, 192, 0.12) 100%
    );
    border-color: rgba(247, 243, 236, 0.75);
  }

  .btn-outline {
    @apply inline-flex items-center justify-center px-6 py-3.5 rounded-full border font-semibold transition;
    border-color: var(--sage-soft);
    color: var(--sage-ink);
    background: #fffdf9;
  }

  .btn-outline:hover {
    border-color: var(--sage);
    background: var(--cream-deep);
  }

  .input {
    @apply w-full px-4 py-3 rounded-xl border bg-white focus:outline-none focus:ring-2;
    border-color: #d9d2c6;
  }

  .input:focus {
    border-color: var(--sage);
    box-shadow: 0 0 0 3px rgba(143, 163, 138, 0.35);
  }

  .label {
    @apply block text-sm font-medium mb-1.5;
    color: #5c6358;
  }
</style>
