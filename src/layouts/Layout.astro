---
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `${site.name} — ${site.title} with ${site.brokerage}. Helping buyers and sellers from Temecula to Orange County since ${site.licensedSince}. DRE# ${site.dre}.`,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.siteUrl).toString();
const years = new Date().getFullYear() - site.licensedSince;
const phoneTel = `+1${site.phone.replace(/\D/g, '')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${title} | ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(site.headshot, site.siteUrl).toString()} />
    <meta name="theme-color" content="#0F2C4C" />
    <title>{title} | {site.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-stone-50 text-stone-900 antialiased">
    <div class="bg-[var(--navy)] text-white/90 text-xs sm:text-sm text-center px-4 py-2">
      Call or text <a class="underline font-medium hover:text-white" href={`tel:${phoneTel}`}>{site.phone}</a>
      <span class="mx-1.5 opacity-50">·</span>
      <span>{site.brokerage}</span>
      <span class="mx-1.5 opacity-50">·</span>
      <span>DRE# {site.dre}</span>
    </div>
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  :root {
    --navy: #0f2c4c;
    --navy-deep: #0a1f36;
    /* Metallic platinum system (cool silver, not gold) */
    --platinum: #c5ccd4;
    --platinum-soft: #e8ecf0;
    --platinum-bright: #f3f5f7;
    --platinum-deep: #8b949e;
    --platinum-metal: linear-gradient(145deg, #f7f8fa 0%, #c5ccd4 42%, #9aa3ad 78%, #dfe3e8 100%);
    --ink: #1c1917;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: "DM Sans", system-ui, sans-serif;
  }

  .font-serif {
    font-family: "Libre Baskerville", Georgia, serif;
  }

  .btn-primary {
    @apply inline-flex items-center justify-center px-6 py-3.5 rounded-full font-semibold transition shadow-md;
    background: var(--platinum-metal);
    color: var(--navy-deep);
    border: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.65) inset,
      0 8px 20px rgba(15, 44, 76, 0.18);
  }

  .btn-primary:hover {
    filter: brightness(1.05);
    background: linear-gradient(145deg, #ffffff 0%, #d5dae0 40%, #a8b0b9 80%, #eef1f4 100%);
  }

  .btn-secondary {
    @apply inline-flex items-center justify-center px-6 py-3.5 rounded-full font-semibold transition;
    border: 1px solid rgba(197, 204, 212, 0.55);
    color: #f3f5f7;
    background: rgba(197, 204, 212, 0.08);
  }

  .btn-secondary:hover {
    background: rgba(197, 204, 212, 0.18);
    border-color: rgba(232, 236, 240, 0.75);
  }

  .btn-outline {
    @apply inline-flex items-center justify-center px-6 py-3.5 rounded-full border font-semibold transition bg-white;
    border-color: #c5ccd4;
    color: var(--navy);
  }

  .btn-outline:hover {
    border-color: var(--navy);
    background: var(--platinum-bright);
  }

  .input {
    @apply w-full px-4 py-3 rounded-xl border border-stone-300 bg-white focus:outline-none focus:ring-2 focus:border-[var(--platinum-deep)];
    focus-ring-color: transparent;
  }

  .input:focus {
    border-color: var(--platinum-deep);
    box-shadow: 0 0 0 3px rgba(197, 204, 212, 0.45);
  }

  .label {
    @apply block text-sm font-medium text-stone-700 mb-1.5;
  }
</style>
