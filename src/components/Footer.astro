---
import site from '../data/site.json';
const year = new Date().getFullYear();
const years = year - site.licensedSince;
const phoneTel = `+1${site.phone.replace(/\D/g, '')}`;
---

<footer class="mt-20">
  <!-- Slim elegance bar like the reference -->
  <div class="bg-[var(--sage-deep)] text-white/90">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 py-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-[11px] tracking-[0.16em] uppercase">
      <div class="flex flex-wrap gap-x-6 gap-y-2 justify-center md:justify-start">
        <a href="/about" class="hover:text-white transition">About</a>
        <a href="/contact" class="hover:text-white transition">Contact</a>
        <a href="/privacy" class="hover:text-white transition">Privacy Policy</a>
        <a href="/terms" class="hover:text-white transition">Terms</a>
      </div>
      <div class="text-center md:text-right text-white/80">
        {site.nameWithCredentials} · Listing Agent
      </div>
    </div>
  </div>

  <div class="bg-[var(--ivory-deep)] text-[var(--muted)]">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 py-12">
      <div class="grid md:grid-cols-4 gap-10">
        <div class="md:col-span-2">
          <div class="font-serif text-3xl text-[var(--sage-ink)] tracking-[0.06em] mb-3">{site.nameWithCredentials}</div>
          <p class="text-sm leading-relaxed max-w-md">
            Listing Agent · {site.title} with {site.brokerage}. Primary focus: Temecula homes and estates — also representing buyers. Service areas include Murrieta, Hacienda Heights, and Orange County.
            Licensed REALTOR® since {site.licensedSince} ({years}+ years).
          </p>
          <div class="mt-5 space-y-1 text-sm text-[var(--sage-ink)]">
            <a class="block hover:underline" href={`tel:${phoneTel}`}>{site.phone}</a>
            <a class="block hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>

        <div>
          <div class="text-[var(--sage-ink)] font-medium mb-4 text-xs tracking-[0.18em] uppercase">Explore</div>
          <div class="space-y-2 text-sm">
            <a href="/sell" class="block hover:text-[var(--sage-ink)]">Sell your home</a>
            <a href="/buy" class="block hover:text-[var(--sage-ink)]">Buy a home</a>
            <a href="/areas" class="block hover:text-[var(--sage-ink)]">Areas served</a>
            <a href="/about" class="block hover:text-[var(--sage-ink)]">About Laura</a>
            <a href="/contact" class="block hover:text-[var(--sage-ink)]">Contact</a>
          </div>
        </div>

        <div>
          <div class="text-[var(--sage-ink)] font-medium mb-4 text-xs tracking-[0.18em] uppercase">Legal</div>
          <div class="space-y-2 text-sm">
            <a href="/privacy" class="block hover:text-[var(--sage-ink)]">Privacy Policy</a>
            <a href="/terms" class="block hover:text-[var(--sage-ink)]">Terms of Use</a>
            <p class="pt-3 text-xs leading-relaxed">
              Equal Housing Opportunity. Each office is independently owned and operated.
            </p>
          </div>
        </div>
      </div>

      <div class="border-t border-[var(--line)] mt-10 pt-8 text-xs space-y-3">
        <p>
          © {year} {site.name}. All rights reserved.
          {site.name}, {site.title}, DRE# {site.dre}, {site.brokerage}.
        </p>
        <p>
          This site is for general real estate information and lead inquiries only. It is not a solicitation if your
          property is currently listed with another broker. Information deemed reliable but not guaranteed.
        </p>
      </div>
    </div>
  </div>
</footer>
