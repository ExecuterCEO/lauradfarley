---
import site from '../data/site.json';

const phoneTel = `+1${site.phone.replace(/\D/g, '')}`;

const links = [
  { href: '/sell', label: 'Sell' },
  { href: '/buy', label: 'Buy' },
  { href: '/areas', label: 'Areas' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<nav class="bg-[color:var(--cream)]/95 backdrop-blur border-b border-[color:var(--cream-deep)] sticky top-0 z-50" id="site-nav">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 h-[4.5rem] flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 min-w-0 group">
      <div class="w-10 h-10 shrink-0 rounded-xl flex items-center justify-center font-serif text-lg"
           style="background: linear-gradient(145deg, #6f846a 0%, #4a5c47 55%, #3a4838 100%); color: #f7f3ec; box-shadow: inset 0 1px 0 rgba(255,255,255,0.28);">
        LF
      </div>
      <div class="min-w-0">
        <div class="font-serif text-lg sm:text-xl text-[var(--navy)] tracking-tight truncate group-hover:text-[var(--navy)]">
          {site.name}
        </div>
        <div class="text-[10px] sm:text-[11px] text-stone-500 -mt-0.5 tracking-wide uppercase">
          {site.brokerage} · DRE# {site.dre}
        </div>
      </div>
    </a>

    <div class="hidden lg:flex items-center gap-6 text-sm font-medium text-stone-700">
      {links.map((l) => (
        <a href={l.href} class="hover:text-[var(--navy)] transition">{l.label}</a>
      ))}
    </div>

    <div class="hidden md:flex items-center gap-2">
      <a href={`tel:${phoneTel}`} class="text-sm font-medium text-[var(--navy)] px-3 py-2 hover:underline whitespace-nowrap">
        {site.phone}
      </a>
      <a href="/sell#valuation" class="btn-primary !py-2.5 !px-5 text-sm whitespace-nowrap">
        Free home value
      </a>
    </div>

    <button
      type="button"
      id="mobile-menu-btn"
      class="lg:hidden inline-flex items-center justify-center w-11 h-11 -mr-1 rounded-xl text-stone-700 hover:bg-stone-100"
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-stone-200 bg-white shadow-lg">
    <div class="max-w-6xl mx-auto px-5 py-4 flex flex-col gap-1">
      {links.map((l) => (
        <a href={l.href} class="mobile-nav-link block px-3 py-3 rounded-xl text-base font-medium text-stone-800 hover:bg-stone-50">
          {l.label}
        </a>
      ))}
      <a href={`tel:${phoneTel}`} class="mobile-nav-link block px-3 py-3 rounded-xl text-base font-medium text-[var(--navy)]">
        Call {site.phone}
      </a>
      <a href="/sell#valuation" class="mobile-nav-link mt-2 block text-center btn-primary">
        Free home value
      </a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  function setOpen(open: boolean) {
    if (!btn || !menu || !iconOpen || !iconClose) return;
    menu.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  btn?.addEventListener('click', () => {
    setOpen(btn.getAttribute('aria-expanded') !== 'true');
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) setOpen(false);
  });
</script>
